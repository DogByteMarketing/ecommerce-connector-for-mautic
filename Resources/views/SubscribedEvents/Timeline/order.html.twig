{#
  In-document ajax modal link. Assets/js/ecommerce.js opens it from the History row
  after the click event finishes so Bootstrap does not dismiss the modal immediately.
#}
<a class="js-ecommerce-order-timeline hide"
   href="{{ event.extra.modalUrl }}"
   data-toggle="ajaxmodal"
   data-target="#MauticSharedModal"
   data-header="{{ event.extra.modalHeader }}"
   data-order-title="{{ 'mautic.plugin.ecommerce.tab.view_order'|trans }}"></a>
